{
  "expo": {
    "name": "Jarvis Remote",
    "slug": "jarvis-remote",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "jarvisremote",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": false,
      "bundleIdentifier": "com.personal.jarvisremote",
      "infoPlist": {
        "CFBundleDisplayName": "Jarvis",
        "NSLocalNetworkUsageDescription": "Jarvis Remote finds your Mac on Wi‑Fi or Tailscale.",
        "NSMicrophoneUsageDescription": "Jarvis Remote records a short clip to send to your Mac.",
        "NSCameraUsageDescription": "Jarvis Remote takes a photo to send to your Mac.",
        "NSPhotoLibraryUsageDescription": "Jarvis Remote can send a photo from your library to your Mac.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.personal.jarvisremote",
      "usesCleartextTraffic": true,
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#0B0C0F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "jarvisremote"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0C0F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-system-ui",
      [
        "expo-audio",
        {
          "microphonePermission": "Jarvis Remote records a short clip to send to your Mac.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Jarvis Remote takes a photo to send to your Mac.",
          "photosPermission": "Jarvis Remote can send a photo from your library to your Mac."
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "JarvisCompose",
              "label": "Jarvis",
              "description": "Command, mic, and camera for Jarvis",
              "minWidth": "250dp",
              "minHeight": "80dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/images/widget-preview.png"
            }
          ]
        }
      ],
      "./plugins/with-lan-http"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
